---
import { recordToSpecSlots, SPEC_SLOT_COUNT } from '../../lib/validation';
import { centsToShillings } from '../../lib/money';
import type { Category } from '@prisma/client';

interface Defaults {
  id?: string;
  sku?: string;
  name?: string;
  slug?: string;
  brand?: string;
  shortDescription?: string;
  description?: string;
  priceCents?: number;
  compareAtCents?: number | null;
  stockQuantity?: number;
  categoryId?: string;
  isFeatured?: boolean;
  isActive?: boolean;
  specs?: Record<string, string>;
  images?: string[];
}

interface Props {
  action: any;
  categories: Category[];
  defaults?: Defaults;
  submitLabel: string;
}

const { action, categories, defaults = {}, submitLabel } = Astro.props;
const specSlots = recordToSpecSlots(defaults.specs ?? {});
const existingImages = defaults.images ?? [];
---

<form method="POST" action={action} class="space-y-6">
  {defaults.id && <input type="hidden" name="id" value={defaults.id} />}

  <!-- Image Management Section -->
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <div class="mb-4 flex items-center gap-2">
      <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0023.25 18.75V5.25A2.25 2.25 0 0021 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
      </svg>
      <p class="text-sm font-semibold text-slate-700">Product Images</p>
    </div>

    {existingImages.length > 0 && (
      <div class="mb-4">
        <p class="mb-2 text-xs font-medium text-slate-500">Current Images</p>
        <div class="flex flex-wrap gap-3">
          {existingImages.map((img, i) => (
            <div class="group relative">
              <img
                src={img}
                alt={`Product image ${i + 1}`}
                class="h-20 w-20 rounded-lg border border-slate-200 bg-slate-50 object-contain p-1"
              />
              <span class="absolute -top-1.5 -right-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-slate-700 text-[0.5625rem] font-bold text-white">{i + 1}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <div id="image-url-fields">
      <p class="mb-2 text-xs font-medium text-slate-500">Image URLs (paste links to product images)</p>
      <div class="space-y-2" id="image-inputs">
        {(existingImages.length > 0 ? existingImages : ['']).map((url, i) => (
          <div class="flex gap-2 image-row">
            <input
              class="input flex-1"
              type="url"
              name={`imageUrl${i + 1}`}
              placeholder="https://example.com/product-image.jpg"
              value={url.startsWith('/api/placeholder') ? '' : url}
            />
            {i > 0 && (
              <button type="button" class="remove-image-btn shrink-0 rounded-lg border border-red-200 px-2.5 text-red-400 hover:bg-red-50 hover:text-red-600" title="Remove">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            )}
          </div>
        ))}
      </div>
      <button type="button" id="add-image-btn" class="mt-2 flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-brand hover:bg-orange-50">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        Add another image
      </button>
    </div>
    <p class="mt-2 text-xs text-slate-400">
      Paste direct links to product images. Leave empty to keep existing images.
    </p>
  </div>

  <!-- Basic Info -->
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <div class="mb-4 flex items-center gap-2">
      <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
      </svg>
      <p class="text-sm font-semibold text-slate-700">Basic Information</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <label class="label" for="sku">SKU</label>
        <input class="input" type="text" id="sku" name="sku" required value={defaults.sku ?? ''} />
      </div>
      <div>
        <label class="label" for="brand">Brand</label>
        <input class="input" type="text" id="brand" name="brand" required value={defaults.brand ?? ''} />
      </div>
    </div>

    <div class="mt-4">
      <label class="label" for="name">Product Name</label>
      <input class="input" type="text" id="name" name="name" required value={defaults.name ?? ''} />
    </div>

    <div class="mt-4">
      <label class="label" for="slug">URL Slug</label>
      <input class="input" type="text" id="slug" name="slug" required pattern="[a-z0-9-]+" value={defaults.slug ?? ''} />
      <p class="mt-1 text-xs text-slate-400">Lowercase letters, numbers, and hyphens only</p>
    </div>

    <div class="mt-4">
      <label class="label" for="categoryId">Category</label>
      <select class="input" id="categoryId" name="categoryId" required>
        {categories.map((category) => (
          <option value={category.id} selected={category.id === defaults.categoryId}>
            {category.name}
          </option>
        ))}
      </select>
    </div>
  </div>

  <!-- Description -->
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <div class="mb-4 flex items-center gap-2">
      <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
      </svg>
      <p class="text-sm font-semibold text-slate-700">Description</p>
    </div>

    <div>
      <label class="label" for="shortDescription">Short Description</label>
      <input class="input" type="text" id="shortDescription" name="shortDescription" required value={defaults.shortDescription ?? ''} />
    </div>

    <div class="mt-4">
      <label class="label" for="description">Full Description</label>
      <textarea class="input" id="description" name="description" rows="5" required>{defaults.description ?? ''}</textarea>
    </div>
  </div>

  <!-- Pricing & Stock -->
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <div class="mb-4 flex items-center gap-2">
      <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
      </svg>
      <p class="text-sm font-semibold text-slate-700">Pricing & Stock</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div>
        <label class="label" for="priceShillings">Price (KES)</label>
        <input class="input" type="number" id="priceShillings" name="priceShillings" min="0" step="0.01" required value={defaults.priceCents != null ? centsToShillings(defaults.priceCents) : 0} />
      </div>
      <div>
        <label class="label" for="compareAtShillings">Compare-At Price (KES)</label>
        <input class="input" type="number" id="compareAtShillings" name="compareAtShillings" min="0" step="0.01" value={defaults.compareAtCents != null ? centsToShillings(defaults.compareAtCents) : ''} />
        <p class="mt-1 text-xs text-slate-400">Original price (shows strikethrough)</p>
      </div>
      <div>
        <label class="label" for="stockQuantity">Stock Quantity</label>
        <input class="input" type="number" id="stockQuantity" name="stockQuantity" min="0" required value={defaults.stockQuantity ?? 0} />
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-6">
      <label class="flex items-center gap-2.5 text-sm text-slate-700 cursor-pointer">
        <input type="checkbox" name="isFeatured" value="true" checked={defaults.isFeatured} class="h-4 w-4 rounded border-slate-300 accent-brand" />
        <span>Featured Product</span>
      </label>
      <label class="flex items-center gap-2.5 text-sm text-slate-700 cursor-pointer">
        <input type="checkbox" name="isActive" value="true" checked={defaults.isActive ?? true} class="h-4 w-4 rounded border-slate-300 accent-brand" />
        <span>Active (visible in store)</span>
      </label>
    </div>
  </div>

  <!-- Specifications -->
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <div class="mb-4 flex items-center gap-2">
      <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <p class="text-sm font-semibold text-slate-700">Specifications</p>
    </div>

    <div class="space-y-2">
      {Array.from({ length: SPEC_SLOT_COUNT }, (_, i) => i + 1).map((n) => (
        <div class="grid grid-cols-2 gap-2">
          <input class="input" type="text" name={`spec${n}.key`} placeholder="Key (e.g. Frequency)" value={specSlots[n - 1]?.key ?? ''} />
          <input class="input" type="text" name={`spec${n}.value`} placeholder="Value (e.g. 5 GHz)" value={specSlots[n - 1]?.value ?? ''} />
        </div>
      ))}
    </div>
    <p class="mt-2 text-xs text-slate-400">Fill in key-value pairs. Empty rows are ignored.</p>
  </div>

  <button type="submit" class="btn btn-primary w-full text-base">{submitLabel}</button>
</form>

<script>
  const container = document.getElementById('image-inputs');
  const addBtn = document.getElementById('add-image-btn');
  let count = container?.children.length ?? 1;

  addBtn?.addEventListener('click', () => {
    if (count >= 5) return;
    count++;
    const row = document.createElement('div');
    row.className = 'flex gap-2 image-row';
    row.innerHTML = `
      <input class="input flex-1" type="url" name="imageUrl${count}" placeholder="https://example.com/product-image.jpg" />
      <button type="button" class="remove-image-btn shrink-0 rounded-lg border border-red-200 px-2.5 text-red-400 hover:bg-red-50 hover:text-red-600" title="Remove">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    `;
    container?.appendChild(row);
  });

  container?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.remove-image-btn');
    if (btn) btn.closest('.image-row')?.remove();
  });
</script>
