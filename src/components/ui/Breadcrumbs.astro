---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="mb-4 flex items-center gap-1.5 text-sm text-slate-500" aria-label="Breadcrumb">
  <a href="/" class="hover:text-info">Home</a>
  {
    items.map((item) => (
      <>
        <span aria-hidden="true">/</span>
        {item.href ? (
          <a href={item.href} class="hover:text-info">
            {item.label}
          </a>
        ) : (
          <span class="font-medium text-slate-700">{item.label}</span>
        )}
      </>
    ))
  }
</nav>
