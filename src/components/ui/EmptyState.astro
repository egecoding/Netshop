---
interface Props {
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, description, actionHref, actionLabel } = Astro.props;
---

<div class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-slate-300 bg-white py-16 text-center">
  <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
  {description && <p class="max-w-md text-sm text-slate-500">{description}</p>}
  {
    actionHref && actionLabel && (
      <a href={actionHref} class="btn btn-primary mt-2">
        {actionLabel}
      </a>
    )
  }
</div>
