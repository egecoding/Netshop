---
interface Props {
  label: string;
  value: string;
  tone?: 'default' | 'warning';
}

const { label, value, tone = 'default' } = Astro.props;
---

<div class="card p-5">
  <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">{label}</p>
  <p class={`mt-1 text-2xl font-bold ${tone === 'warning' ? 'text-amber-600' : 'text-slate-900'}`}>{value}</p>
</div>
