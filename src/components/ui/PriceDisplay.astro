---
import { formatCents, percentOff } from '../../lib/money';

interface Props {
  priceCents: number;
  compareAtCents?: number | null;
  size?: 'sm' | 'lg';
}

const { priceCents, compareAtCents, size = 'sm' } = Astro.props;
const hasDiscount = !!compareAtCents && compareAtCents > priceCents;
const priceClass = size === 'lg' ? 'text-2xl font-extrabold text-sale' : 'text-base font-extrabold text-sale';
---

<div class="flex items-baseline gap-2 font-mono">
  <span class={priceClass}>{formatCents(priceCents)}</span>
  {
    hasDiscount && (
      <>
        <span class="text-sm text-slate-400 line-through">{formatCents(compareAtCents!)}</span>
        {size === 'lg' && (
          <span class="rounded bg-red-50 px-1.5 py-0.5 text-xs font-semibold text-sale">
            Save {percentOff(priceCents, compareAtCents!)}%
          </span>
        )}
      </>
    )
  }
</div>
