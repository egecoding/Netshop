---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { actions } from 'astro:actions';
import { prisma } from '../../lib/db';

const user = Astro.locals.user!;

const addResult = Astro.getActionResult(actions.account.addAddress);

const addresses = await prisma.address.findMany({
  where: { userId: user.id },
  orderBy: [{ isDefault: 'desc' }, { id: 'asc' }],
});
---

<AccountLayout title="Addresses">
  <h1 class="text-2xl font-bold text-slate-900">Addresses</h1>

  {
    addresses.length === 0 ? (
      <p class="mt-6 text-sm text-slate-500">You haven't saved any addresses yet.</p>
    ) : (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {addresses.map((address) => (
          <li class="card p-4">
            {address.isDefault && (
              <span class="mb-2 inline-block rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">
                Default
              </span>
            )}
            <address class="text-sm text-slate-600 not-italic">
              {address.fullName}<br />
              {address.line1}{address.line2 ? `, ${address.line2}` : ''}<br />
              {address.city}, {address.state} {address.postalCode}<br />
              {address.country}
            </address>
            <form method="POST" action={actions.account.deleteAddress} class="mt-3">
              <input type="hidden" name="id" value={address.id} />
              <button type="submit" class="text-xs font-semibold text-red-600 hover:underline">
                Remove
              </button>
            </form>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-8">
    <h2 class="font-semibold text-slate-900">Add New Address</h2>
    {
      addResult?.error && (
        <div class="mt-3 rounded-md bg-red-50 p-3 text-sm text-red-700">{addResult.error.message}</div>
      )
    }
    <form method="POST" action={actions.account.addAddress} class="card mt-3 space-y-4 p-6">
      <div>
        <label class="label" for="fullName">Full Name</label>
        <input class="input" type="text" id="fullName" name="fullName" required />
      </div>
      <div>
        <label class="label" for="line1">Address Line 1</label>
        <input class="input" type="text" id="line1" name="line1" required />
      </div>
      <div>
        <label class="label" for="line2">Address Line 2 (optional)</label>
        <input class="input" type="text" id="line2" name="line2" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="label" for="city">City</label>
          <input class="input" type="text" id="city" name="city" required />
        </div>
        <div>
          <label class="label" for="state">County</label>
          <input class="input" type="text" id="state" name="state" required />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="label" for="postalCode">Postal Code</label>
          <input class="input" type="text" id="postalCode" name="postalCode" required />
        </div>
        <div>
          <label class="label" for="country">Country</label>
          <input class="input" type="text" id="country" name="country" value="KE" maxlength="2" required />
        </div>
      </div>
      <div>
        <label class="label" for="phone">Phone (optional)</label>
        <input class="input" type="tel" id="phone" name="phone" />
      </div>
      <label class="flex items-center gap-2 text-sm text-slate-700">
        <input type="checkbox" name="isDefault" value="true" class="h-4 w-4 rounded border-slate-300" />
        Set as default address
      </label>
      <button type="submit" class="btn btn-primary w-full">Save Address</button>
    </form>
  </div>
</AccountLayout>
