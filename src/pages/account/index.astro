---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { formatCents } from '../../lib/money';
import { prisma } from '../../lib/db';

const user = Astro.locals.user!;
const recentOrders = await prisma.order.findMany({
  where: { userId: user.id },
  orderBy: { placedAt: 'desc' },
  take: 3,
});
---

<AccountLayout title="My Account">
  <h1 class="text-2xl font-bold text-slate-900">Welcome back, {user.name.split(' ')[0]}</h1>
  <p class="mt-1 text-sm text-slate-500">{user.email}</p>

  <div class="mt-8">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="font-semibold text-slate-900">Recent Orders</h2>
      <a href="/account/orders" class="text-sm font-semibold text-info hover:underline">View all &rarr;</a>
    </div>
    {
      recentOrders.length === 0 ? (
        <p class="text-sm text-slate-500">You haven't placed any orders yet.</p>
      ) : (
        <ul class="card divide-y divide-slate-100">
          {recentOrders.map((order) => (
            <li class="flex items-center justify-between p-4 text-sm">
              <div>
                <a href={`/account/orders/${order.id}`} class="font-mono font-semibold text-slate-900 hover:text-info">
                  {order.orderNumber}
                </a>
                <p class="text-xs text-slate-500">{order.placedAt.toLocaleDateString()} &middot; {order.status}</p>
              </div>
              <p class="font-mono font-semibold text-slate-900">{formatCents(order.totalCents)}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</AccountLayout>
