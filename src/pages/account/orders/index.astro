---
import AccountLayout from '../../../layouts/AccountLayout.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import { formatCents } from '../../../lib/money';
import { prisma } from '../../../lib/db';

const user = Astro.locals.user!;
const orders = await prisma.order.findMany({
  where: { userId: user.id },
  orderBy: { placedAt: 'desc' },
});
---

<AccountLayout title="Order History">
  <h1 class="text-2xl font-bold text-slate-900">Order History</h1>

  {
    orders.length === 0 ? (
      <div class="mt-6">
        <EmptyState
          title="No orders yet"
          description="When you place an order, it will show up here."
          actionHref="/products"
          actionLabel="Shop Products"
        />
      </div>
    ) : (
      <ul class="card mt-6 divide-y divide-slate-100">
        {orders.map((order) => (
          <li class="flex items-center justify-between p-4 text-sm">
            <div>
              <a href={`/account/orders/${order.id}`} class="font-mono font-semibold text-slate-900 hover:text-info">
                {order.orderNumber}
              </a>
              <p class="text-xs text-slate-500">{order.placedAt.toLocaleDateString()}</p>
            </div>
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">
              {order.status}
            </span>
            <p class="font-mono font-semibold text-slate-900">{formatCents(order.totalCents)}</p>
          </li>
        ))}
      </ul>
    )
  }
</AccountLayout>
