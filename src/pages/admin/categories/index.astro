---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { prisma } from '../../../lib/db';

const categories = await prisma.category.findMany({
  orderBy: { sortOrder: 'asc' },
  include: { _count: { select: { products: true } } },
});
---

<AdminLayout title="Categories">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-slate-900">Categories</h1>
    <a href="/admin/categories/new" class="btn btn-primary">+ New Category</a>
  </div>

  <div class="card mt-6 divide-y divide-slate-100">
    {
      categories.map((category) => (
        <a href={`/admin/categories/${category.id}`} class="flex items-center justify-between p-4 text-sm hover:bg-slate-50">
          <div>
            <p class="font-semibold text-slate-900">{category.name}</p>
            <p class="text-xs text-slate-500">{category.slug}</p>
          </div>
          <span class="text-slate-500">{category._count.products} products</span>
        </a>
      ))
    }
  </div>
</AdminLayout>
