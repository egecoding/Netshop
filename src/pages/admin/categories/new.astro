---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../components/admin/CategoryForm.astro';
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.admin.categories.create);
if (result && !result.error && result.data) {
  return Astro.redirect(`/admin/categories/${result.data.id}`);
}
---

<AdminLayout title="New Category">
  <a href="/admin/categories" class="text-sm font-semibold text-info hover:underline">&larr; Back to Categories</a>
  <h1 class="mt-3 text-2xl font-bold text-slate-900">New Category</h1>

  {
    result?.error && (
      <div class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-700">{result.error.message}</div>
    )
  }

  <div class="mt-6">
    <CategoryForm action={actions.admin.categories.create} submitLabel="Create Category" />
  </div>
</AdminLayout>
