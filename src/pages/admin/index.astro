---
import AdminLayout from '../../layouts/AdminLayout.astro';
import KpiTile from '../../components/ui/KpiTile.astro';
import { formatCents } from '../../lib/money';
import { prisma } from '../../lib/db';
import { LOW_STOCK_THRESHOLD } from '../../lib/constants';

const [orderCount, revenue, lowStockProducts, productCount, customerCount, recentOrders] = await Promise.all([
  prisma.order.count(),
  prisma.order.aggregate({ _sum: { totalCents: true } }),
  prisma.product.findMany({
    where: { stockQuantity: { lte: LOW_STOCK_THRESHOLD }, isActive: true },
    orderBy: { stockQuantity: 'asc' },
    take: 8,
  }),
  prisma.product.count(),
  prisma.user.count({ where: { role: 'CUSTOMER' } }),
  prisma.order.findMany({ orderBy: { placedAt: 'desc' }, take: 6 }),
]);
---

<AdminLayout title="Dashboard">
  <h1 class="text-2xl font-bold text-slate-900">Dashboard</h1>

  <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <KpiTile label="Orders" value={String(orderCount)} />
    <KpiTile label="Revenue" value={formatCents(revenue._sum.totalCents ?? 0)} />
    <KpiTile label="Products" value={String(productCount)} />
    <KpiTile label="Customers" value={String(customerCount)} />
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <div>
      <h2 class="mb-3 font-semibold text-slate-900">Recent Orders</h2>
      <div class="card divide-y divide-slate-100">
        {
          recentOrders.map((order) => (
            <a href={`/admin/orders/${order.id}`} class="flex items-center justify-between p-4 text-sm hover:bg-slate-50">
              <div>
                <p class="font-mono font-semibold text-slate-900">{order.orderNumber}</p>
                <p class="text-xs text-slate-500">{order.placedAt.toLocaleDateString()}</p>
              </div>
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{order.status}</span>
              <p class="font-mono font-semibold text-slate-900">{formatCents(order.totalCents)}</p>
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h2 class="mb-3 font-semibold text-slate-900">Low Stock</h2>
      <div class="card divide-y divide-slate-100">
        {
          lowStockProducts.length === 0 ? (
            <p class="p-4 text-sm text-slate-500">Nothing is low on stock.</p>
          ) : (
            lowStockProducts.map((product) => (
              <a href={`/admin/products/${product.id}`} class="flex items-center justify-between p-4 text-sm hover:bg-slate-50">
                <div>
                  <p class="font-semibold text-slate-900">{product.name}</p>
                  <p class="font-mono text-xs text-slate-400">{product.sku}</p>
                </div>
                <span class="font-semibold text-amber-600">{product.stockQuantity} left</span>
              </a>
            ))
          )
        }
      </div>
    </div>
  </div>
</AdminLayout>
