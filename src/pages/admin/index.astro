---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatCents } from '../../lib/money';
import { prisma } from '../../lib/db';
import { LOW_STOCK_THRESHOLD } from '../../lib/constants';

const [orderCount, revenue, lowStockProducts, productCount, customerCount, recentOrders] = await Promise.all([
  prisma.order.count(),
  prisma.order.aggregate({ _sum: { totalCents: true } }),
  prisma.product.findMany({
    where: { stockQuantity: { lte: LOW_STOCK_THRESHOLD }, isActive: true },
    orderBy: { stockQuantity: 'asc' },
    take: 8,
  }),
  prisma.product.count(),
  prisma.user.count({ where: { role: 'CUSTOMER' } }),
  prisma.order.findMany({ orderBy: { placedAt: 'desc' }, take: 8, include: { user: true } }),
]);

const statusColors: Record<string, string> = {
  PENDING_PAYMENT: 'bg-amber-100 text-amber-700',
  PAID: 'bg-blue-100 text-blue-700',
  PROCESSING: 'bg-indigo-100 text-indigo-700',
  SHIPPED: 'bg-purple-100 text-purple-700',
  DELIVERED: 'bg-green-100 text-green-700',
  CANCELLED: 'bg-red-100 text-red-700',
};
---

<AdminLayout title="Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Dashboard</h1>
    <p class="mt-1 text-sm text-slate-500">Welcome back. Here's what's happening with your store.</p>
  </div>

  <!-- KPI Cards -->
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50">
        <svg class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
      </div>
      <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">Total Orders</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{orderCount}</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-green-50">
        <svg class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </div>
      <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">Revenue</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{formatCents(revenue._sum.totalCents ?? 0)}</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-orange-50">
        <svg class="h-5 w-5 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
      </div>
      <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">Products</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{productCount}</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-purple-50">
        <svg class="h-5 w-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      </div>
      <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">Customers</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{customerCount}</p>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="mt-6 flex flex-wrap gap-3">
    <a href="/admin/products/new" class="btn btn-primary text-sm">+ Add Product</a>
    <a href="/admin/categories/new" class="btn btn-secondary text-sm">+ Add Category</a>
    <a href="/admin/orders" class="btn btn-secondary text-sm">View All Orders</a>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    <!-- Recent Orders (takes 2 cols) -->
    <div class="lg:col-span-2">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-semibold text-slate-900">Recent Orders</h2>
        <a href="/admin/orders" class="text-sm font-medium text-brand hover:underline">View all</a>
      </div>
      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50">
              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Order</th>
              <th class="hidden px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase sm:table-cell">Customer</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Status</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {recentOrders.map((order) => (
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-4 py-3">
                  <a href={`/admin/orders/${order.id}`} class="font-mono text-sm font-semibold text-brand hover:underline">{order.orderNumber}</a>
                  <p class="text-xs text-slate-400 mt-0.5">{order.placedAt.toLocaleDateString()}</p>
                </td>
                <td class="hidden px-4 py-3 text-slate-600 sm:table-cell">{order.shippingName}</td>
                <td class="px-4 py-3">
                  <span class={`inline-block rounded-full px-2.5 py-0.5 text-[0.6875rem] font-semibold ${statusColors[order.status] ?? 'bg-slate-100 text-slate-600'}`}>
                    {order.status.replace(/_/g, ' ')}
                  </span>
                </td>
                <td class="px-4 py-3 text-right font-mono font-semibold text-slate-900">{formatCents(order.totalCents)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Low Stock Alert -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-semibold text-slate-900">Low Stock Alert</h2>
        {lowStockProducts.length > 0 && (
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-red-500 text-[0.625rem] font-bold text-white">{lowStockProducts.length}</span>
        )}
      </div>
      <div class="rounded-xl border border-slate-200 bg-white divide-y divide-slate-100">
        {lowStockProducts.length === 0 ? (
          <div class="p-6 text-center">
            <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-green-50">
              <svg class="h-5 w-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
            <p class="text-sm text-slate-500">All stock levels are healthy</p>
          </div>
        ) : (
          lowStockProducts.map((product) => (
            <a href={`/admin/products/${product.id}`} class="flex items-center justify-between p-3.5 hover:bg-slate-50 transition-colors">
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium text-slate-900">{product.name}</p>
                <p class="font-mono text-xs text-slate-400">{product.sku}</p>
              </div>
              <span class={`ml-3 shrink-0 rounded-full px-2.5 py-0.5 text-xs font-bold ${product.stockQuantity === 0 ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>
                {product.stockQuantity === 0 ? 'Out of stock' : `${product.stockQuantity} left`}
              </span>
            </a>
          ))
        )}
      </div>
    </div>
  </div>
</AdminLayout>
