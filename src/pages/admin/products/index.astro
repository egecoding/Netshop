---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { formatCents } from '../../../lib/money';
import { prisma } from '../../../lib/db';

const PAGE_SIZE = 20;
const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const where = q
  ? { OR: [{ name: { contains: q } }, { sku: { contains: q } }, { brand: { contains: q } }] }
  : {};

const [products, total] = await Promise.all([
  prisma.product.findMany({
    where,
    include: { category: true },
    orderBy: { createdAt: 'desc' },
    skip: (page - 1) * PAGE_SIZE,
    take: PAGE_SIZE,
  }),
  prisma.product.count({ where }),
]);
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

function buildHref(p: number) {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  params.set('page', String(p));
  return `/admin/products?${params.toString()}`;
}
---

<AdminLayout title="Products">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-slate-900">Products</h1>
    <a href="/admin/products/new" class="btn btn-primary">+ New Product</a>
  </div>

  <form method="get" class="mt-4">
    <input class="input max-w-sm" type="search" name="q" placeholder="Search by name, SKU, or brand" value={q} />
  </form>

  <div class="card mt-4 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="border-b border-slate-200 text-left text-xs font-semibold text-slate-500 uppercase">
        <tr>
          <th class="px-4 py-3">Product</th>
          <th class="px-4 py-3">Category</th>
          <th class="px-4 py-3">Price</th>
          <th class="px-4 py-3">Stock</th>
          <th class="px-4 py-3">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {
          products.map((product) => (
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-3">
                <a href={`/admin/products/${product.id}`} class="font-semibold text-slate-900 hover:text-info">
                  {product.name}
                </a>
                <p class="font-mono text-xs text-slate-400">{product.sku}</p>
              </td>
              <td class="px-4 py-3 text-slate-600">{product.category.name}</td>
              <td class="px-4 py-3 font-mono text-slate-900">{formatCents(product.priceCents)}</td>
              <td class="px-4 py-3">{product.stockQuantity}</td>
              <td class="px-4 py-3">
                <span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${product.isActive ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500'}`}>
                  {product.isActive ? 'Active' : 'Hidden'}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <Pagination page={page} totalPages={totalPages} buildHref={buildHref} />
</AdminLayout>
