---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { prisma } from '../../../lib/db';

const requests = await prisma.quoteRequest.findMany({
  include: { items: true },
  orderBy: { createdAt: 'desc' },
});
---

<AdminLayout title="Quote Requests">
  <h1 class="text-2xl font-bold text-slate-900">Quote Requests</h1>

  {
    requests.length === 0 ? (
      <p class="mt-6 text-sm text-slate-500">No quote requests yet.</p>
    ) : (
      <div class="mt-6 space-y-4">
        {requests.map((req) => (
          <div class="card p-5">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-semibold text-slate-900">{req.companyName}</p>
                <p class="text-sm text-slate-500">{req.contactName} &middot; {req.email}{req.phone ? ` · ${req.phone}` : ''}</p>
              </div>
              <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${req.status === 'RESPONDED' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'}`}>
                {req.status}
              </span>
            </div>
            <ul class="mt-3 space-y-1 text-sm text-slate-600">
              {req.items.map((item) => (
                <li>&bull; {item.productNameFreeText || item.productId} &times; {item.quantity}</li>
              ))}
            </ul>
            {req.notes && <p class="mt-2 text-sm text-slate-500">Notes: {req.notes}</p>}
            {req.status !== 'RESPONDED' && (
              <form method="POST" action={actions.admin.quotes.markResponded} class="mt-3">
                <input type="hidden" name="id" value={req.id} />
                <button type="submit" class="btn btn-secondary text-xs">Mark Responded</button>
              </form>
            )}
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>
