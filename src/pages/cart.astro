---
import ShopLayout from '../layouts/ShopLayout.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { formatCents } from '../lib/money';
import { getCartSummaryForDisplay } from '../lib/cart';

const summary = await getCartSummaryForDisplay(Astro.cookies, Astro.locals.user);
---

<ShopLayout title="Cart">
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <h1 class="text-2xl font-bold text-slate-900">Your Cart</h1>

    {
      summary.lines.length === 0 ? (
        <div class="mt-8">
          <EmptyState
            title="Your cart is empty"
            description="Browse our catalog to find radios, antennas, switches, and more."
            actionHref="/products"
            actionLabel="Shop Products"
          />
        </div>
      ) : (
        <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_320px]">
          <ul class="card divide-y divide-slate-100">
            {summary.lines.map((line) => (
              <li class="flex gap-4 p-4">
                <img
                  src={line.product.images[0]}
                  alt={line.product.name}
                  class="h-20 w-20 shrink-0 rounded-md bg-slate-100 object-contain p-1"
                />
                <div class="flex-1">
                  <a href={`/products/${line.product.slug}`} class="font-semibold text-slate-900 hover:text-info">
                    {line.product.name}
                  </a>
                  <p class="font-mono text-xs text-slate-400">{line.product.sku}</p>
                  <p class="mt-1 font-mono text-sm text-slate-600">{formatCents(line.product.priceCents)} each</p>

                  <div class="mt-2 flex items-center gap-3">
                    <form method="POST" action="/api/cart/update" class="flex items-center gap-2">
                      <input type="hidden" name="productId" value={line.productId} />
                      <select name="quantity" class="input w-16 py-1 text-sm">
                        {Array.from({ length: Math.min(line.product.stockQuantity, 20) || 1 }, (_, i) => i + 1).map((n) => (
                          <option value={n} selected={n === line.quantity}>
                            {n}
                          </option>
                        ))}
                      </select>
                      <button type="submit" class="text-xs font-semibold text-info hover:underline">
                        Update
                      </button>
                    </form>
                    <form method="POST" action="/api/cart/remove">
                      <input type="hidden" name="productId" value={line.productId} />
                      <button type="submit" class="text-xs font-semibold text-red-600 hover:underline">
                        Remove
                      </button>
                    </form>
                  </div>
                </div>
                <p class="font-mono font-semibold text-slate-900">{formatCents(line.lineTotalCents)}</p>
              </li>
            ))}
          </ul>

          <div class="card h-fit p-5">
            <h2 class="font-semibold text-slate-900">Order Summary</h2>
            <div class="mt-3 flex items-center justify-between text-sm">
              <span class="text-slate-600">Subtotal</span>
              <span class="font-mono font-semibold text-slate-900">{formatCents(summary.subtotalCents)}</span>
            </div>
            <p class="mt-1 text-xs text-slate-400">Shipping and tax calculated at checkout.</p>
            <a href="/checkout" class="btn btn-primary mt-4 w-full">
              Proceed to Checkout
            </a>
          </div>
        </div>
      )
    }
  </div>
</ShopLayout>
