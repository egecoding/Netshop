---
import ShopLayout from '../layouts/ShopLayout.astro';
---

<ShopLayout title="Contact Us">
  <div class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-bold text-slate-900">Contact Us</h1>
    <p class="mt-4 text-slate-600">
      For order support, technical questions, or help choosing equipment, reach our team through
      any of the channels below.
    </p>
    <div class="card mt-8 divide-y divide-slate-100">
      <div class="p-5">
        <p class="text-sm font-semibold text-slate-900">Sales &amp; Support Email</p>
        <p class="mt-1 text-sm text-slate-600">support@netshop.test</p>
      </div>
      <div class="p-5">
        <p class="text-sm font-semibold text-slate-900">Phone</p>
        <p class="mt-1 text-sm text-slate-600">(555) 019-2040 — Mon&ndash;Fri, 8am&ndash;6pm MT</p>
      </div>
      <div class="p-5">
        <p class="text-sm font-semibold text-slate-900">Bulk &amp; Installer Orders</p>
        <p class="mt-1 text-sm text-slate-600">
          See our <a href="/bulk-quote" class="font-semibold text-info hover:underline">Bulk Quote</a> page for
          multi-site volume pricing.
        </p>
      </div>
    </div>
  </div>
</ShopLayout>
